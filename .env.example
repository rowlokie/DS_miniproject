# ==============================================================================
# Website Intelligence Assistant — Environment Configuration
# ==============================================================================

# LLM Provider Options: "extractive", "ollama", "groq", "openai", "gemini"
LLM_PROVIDER=extractive
LLM_MODEL=llama3

# Local Ollama URL (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Cloud API Keys (Optional — not required if using extractive or Ollama)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Crawling & Preprocessing Defaults
MAX_CRAWL_PAGES=20
MAX_CRAWL_DEPTH=2
POLITENESS_DELAY=0.2
REQUEST_TIMEOUT=10
RESPECT_ROBOTS_TXT=true

# Chunking & Retrieval
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K=4
SIMILARITY_THRESHOLD=0.25
